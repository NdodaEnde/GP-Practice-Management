# ============================================================================
# PRODUCTION environment template — backend
# ----------------------------------------------------------------------------
# Copy to the prod host's real `.env` (or set as deploy env vars) and fill in.
# NEVER commit the filled-in file (.env / *.env.* are gitignored).
#
# Differences from dev are marked [PROD]. Everything else mirrors dev.
# ============================================================================

# --- Runtime mode -----------------------------------------------------------
# [PROD] MUST be false. The app fails closed: a non-DEBUG process refuses to
# boot on the default JWT secret (see JWT_SECRET_KEY below).
DEBUG=false
LOG_LEVEL=INFO
PORT=8002

# --- Auth secret (CRITICAL) -------------------------------------------------
# [PROD] MUST be set to a strong unique value, or the app will not boot.
# The code default ("your-secret-key-change-in-production") is public and would
# let anyone forge auth tokens. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Supabase (PROD project — separate from dev) ----------------------------
# [PROD] From the PROD Supabase project (Project Settings -> API / Database).
SUPABASE_URL=https://<PROD_REF>.supabase.co
SUPABASE_SERVICE_KEY=<PROD service_role key>
# Session pooler string (port 5432), PROD project, for psql/migrations:
DATABASE_URL=postgresql://postgres.<PROD_REF>:<PROD_DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_NAME=postgres

# --- CORS -------------------------------------------------------------------
# [PROD] The real frontend origin(s) ONLY — never '*'. Comma-separated.
CORS_ORIGINS=https://app.medicdata.co.za

# --- Bootstrap workspace (watcher boot id; processes all workspaces) --------
DEMO_TENANT_ID=<prod bootstrap tenant id>
DEMO_WORKSPACE_ID=<prod bootstrap workspace id>

# --- Extraction / AI (same keys as dev unless you rotate for prod) ----------
LANDING_AI_API_KEY=<landing.ai key>
VISION_AGENT_API_KEY=<vision agent key>
OPENAI_API_KEY=<openai key>   # semantic search indexing + query embedding

# --- Payments (PayFast) -----------------------------------------------------
# NOTE: code uses PayFast; the onboarding guide references Paystack — reconcile
# which gateway is live before launch. [PROD] LIVE credentials, sandbox off.
PAYFAST_MERCHANT_ID=<live merchant id>
PAYFAST_MERCHANT_KEY=<live merchant key>
PAYFAST_PASSPHRASE=<live passphrase>
PAYFAST_SANDBOX=false
SURGISCAN_WEBHOOK_URL=https://api.medicdata.co.za/payfast/webhook

# --- Optional / legacy ------------------------------------------------------
MICROSERVICE_URL=http://localhost:5001
MONGO_URL=<set only if the Mongo-backed paths are used in prod; legacy>

# ============================================================================
# FRONTEND (build-time, NOT this file): build the prod bundle with
#   REACT_APP_BACKEND_URL=https://api.medicdata.co.za
# ============================================================================
