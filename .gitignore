# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
*.log

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development
android-sdk/

# Environment files (secrets — never commit)
.env
*.env
*.env.*
!.env.example
!*.env.example
!.env.production.example
*token.json*
*credentials.json*

# Runtime document storage (contains PHI — never commit)
backend/storage/gp_documents/
backend/storage/temp/
backend/storage/exports/

# PR draft bodies (working scratch)
.pr-body-*.md

# Scratch / preview pages
frontend/src/pages/__Preview*.jsx

# Mining FD: ADE response cache (regenerable via paid API calls)
backend/.cache/

# Mining FD: Exxaro public PDFs (133 MB; re-fetch via
# backend/scripts/download_exxaro_reports.py)
backend/data/exxaro_source_set/**/*.pdf
